# Public API (Render / local). No trailing slash.
# Local:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com

# PostHog (project "new-discovr", US). Leave the key empty and analytics stays off.
NEXT_PUBLIC_POSTHOG_KEY=phc_kgVVmsMBdW4inkhq29VekHqgNvKJMqLXdZruQTqUCzWe
# Events go through our own /ingest proxy (next.config.ts) so ad blockers don't drop them.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# SEO. Leave empty to turn off.
# Google Analytics 4 measurement id, like G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Search Console "HTML tag" verification token (just the content value)
NEXT_PUBLIC_GSC_VERIFICATION=
